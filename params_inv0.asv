function p = params_inv0()
% params_inv0
% インバータ0用の制御パラメータ／モータ定数をまとめて返す関数
%
% 【この関数の目的】
% シミュレーションや制御関数が必要とする定数を、1つの構造体 p に
% 集約して返します。これにより、各関数は p.xxx 形式で同じ定数を
% 参照できるため、設定ミスや重複定義を防ぎやすくなります。
%
% 【組み込みコードとの対応】
% 主に PE1/src/fim_user_inv0.h のコンパイル時定数に対応しています。
% 値は原則としてヘッダ定義に合わせています。
%
% 【使い方】
%   p = params_inv0();
%   Ts = p.TS_INV0_CTRL;
%   などのように参照します。

    % ---------------------------------------------------------------
    % モータ定数
    % （fim_user_inv0.h: PF_INV0, R1_INV0, R2_INV0, LS_INV0, LM_INV0）
    % ---------------------------------------------------------------
    p.PF_INV0      = 4.0;        % 極対数（pole pairs）
    p.R1_INV0      = 0.0044;     % [Ω] 一次抵抗（固定子抵抗）
    p.R2_INV0      = 0.0023;     % [Ω] 二次抵抗（回転子抵抗）
    p.LS_INV0      = 0.00005;    % [H] 漏れインダクタンス（σ(L1+L2)相当）
    p.LM_INV0      = 0.00021;    % [H] 励磁インダクタンス（公称値）
    p.LM_INV0_MODE = 1;          % 0: Lm固定, 1: Lmマップ使用

    % ---------------------------------------------------------------
    % 抵抗温度補正フラグと基準温度
    % ---------------------------------------------------------------
    % ENABLE_* が 1 のとき、温度に応じて R1/R2 を補正します。
    % 0 のときは定数値（補正なし）を使います。
    p.ENABLE_INV0_R1_CMP = 0;    % 1: R1温度補正有効
    p.ENABLE_INV0_R2_CMP = 0;    % 1: R2温度補正有効

    p.TMP_INV0_R1  = 25.6;       % [°C] R1基準温度
    p.TMP_INV0_R2  = 25.6;       % [°C] R2基準温度

    % 銅の温度係数（抵抗温度補正式で使用）
    % R(T)=R(Tref)*(1+α*(T-Tref))
    p.ALPHA_COPPER = 0.00393;    % [1/°C]

    % ---------------------------------------------------------------
    % 電流制限
    % （fim_user_inv0.h: IDQ_INV0_MAX, ID_INV0_REF_MIN/MAX）
    % ---------------------------------------------------------------
    % 電流ベクトルの上限（ピーク値）
    p.IDQ_INV0_MAX    = 10.0 * 1.732051; % [A] ≒ 17.3205 A
    p.ID_INV0_REF_MIN = 3.0;             % [A] d軸電流の最小参照
    p.ID_INV0_REF_MAX = p.IDQ_INV0_MAX;  % [A] d軸電流の最大参照

    % ---------------------------------------------------------------
    % PWM周波数・制御周期
    % ---------------------------------------------------------------
    p.FC_PWM_INV0  = 10000;             % [Hz] PWMキャリア周波数
    p.TS_INV0_CTRL = 1 / p.FC_PWM_INV0; % [s] PWM割り込み周期（100 µs）
    p.TS_1MS       = 0.001;             % [s] 1msタスク周期

    % ---------------------------------------------------------------
    % dq電流PIゲイン設定
    % （fim_user_inv0.h: KP_INV0_IDQ_CTRL_MAX/MIN, KI...）
    % ---------------------------------------------------------------
    % 実装側では、Lsやfs_ctrl等を掛け合わせて最終PIゲインを作ります。
    % ここではその元になる正規化係数を定義しています。
    p.KP_INV0_IDQ_CTRL_MAX = 0.10;   % 正規化Kp上限
    p.KP_INV0_IDQ_CTRL_MIN = 0.10;   % 正規化Kp下限
    p.KI_INV0_IDQ_CTRL_MAX = 0.10;   % 正規化Ki上限
    p.KI_INV0_IDQ_CTRL_MIN = 0.10;   % 正規化Ki下限

    % 変調率に応じたゲイン低減（droop）閾値
    % ※現シミュレーションでは簡略化し固定扱いにしている箇所があります。
    p.LEV_M_KP_INV0_IDQ_CTRL_MAX = 0.85;
    p.LEV_M_KP_INV0_IDQ_CTRL_MIN = 0.99;
    p.LEV_M_KI_INV0_IDQ_CTRL_MAX = 1.00;
    p.LEV_M_KI_INV0_IDQ_CTRL_MIN = 1.10;

    % ---------------------------------------------------------------
    % 電圧制限関連
    % （fim_user_inv0.h: VDQ_INV0_CTRL_MAX, K_INV0_VDQ_MAX など）
    % ---------------------------------------------------------------
    p.VDQ_INV0_CTRL_MAX  = 300.0;  % [V] PI積分器や制御出力のクランプ上限
    p.K_INV0_VDQ_MAX     = 1.20;   % dq電圧ベクトル上限制限係数
    p.K_INV0_VDQ_VCTRL   = 1.13;   % 弱め界磁が参照する電圧目標比
    p.ENABLE_INV0_KICTRL = 1;      % 1: 電流PIの積分項有効

    % ---------------------------------------------------------------
    % 弱め界磁PIゲイン
    % （fim_user_inv0.h: KP_INV0_VDQCTRL, KI_INV0_VDQCTRL）
    % ---------------------------------------------------------------
    p.KP_INV0_VDQCTRL = 0.001;     % 弱め界磁PIの比例ゲイン
    p.KI_INV0_VDQCTRL = 0.0001;    % 弱め界磁PIの積分ゲイン（PWM周期ごと）

    % ---------------------------------------------------------------
    % 速度PI関連
    % （fim_user_inv0.h: KP_INV0_WRCTRL, KI_INV0_WRCTRL 等）
    % ---------------------------------------------------------------
    p.ENABLE_INV0_WRCTRL      = 0;       % 0: トルク指令モード, 1: 速度制御モード
    p.KP_INV0_WRCTRL          = 0.05;    % 速度PI 比例ゲイン
    p.KI_INV0_WRCTRL          = 0.00005; % 速度PI 積分ゲイン
    p.ENABLE_INV0_WRLIMITCTRL = 0;       % 速度制限制御の有効/無効

    % ---------------------------------------------------------------
    % 角速度PLL（角度追従・速度推定）
    % （fim_user_inv0.h: KP_INV0_WRPLL, KI_INV0_WRPLL, WR_INV0_PLL_MAX）
    % ---------------------------------------------------------------
    p.KP_INV0_WRPLL    = 1000.0;   % [rad/s per rad] PLL比例ゲイン
    p.KI_INV0_WRPLL    = 10000.0;  % [rad/s^2 per rad] PLL積分ゲイン
    p.WCLPF_INV0_WRPLL = 800.0;    % [rad/s] PLL出力速度LPFカットオフ
    p.WR_INV0_PLL_MAX  = 20000.0;  % [rad/s] PLL速度出力上限

    % ---------------------------------------------------------------
    % すべり周波数上限
    % ---------------------------------------------------------------
    p.FSL_INV0_REF_MAX = 20.0;     % [Hz] すべり周波数の上限制限

    % ---------------------------------------------------------------
    % トルク指令ランプレート・モード設定
    % ---------------------------------------------------------------
    p.DTQ_INV0_REF_UP  = 10000.0;  % [Nm/s] トルク指令の変化率上限
    p.MODE_INV0_IDQCOM = 1;        % 1: トルクマップモード（通常）
                                  % 0: irms/theta モード

    % ---------------------------------------------------------------
    % トルク推定関連LPF
    % ---------------------------------------------------------------
    p.WCLPF_INV0_P123            = 200.0;  % [rad/s] 電力LPFカットオフ
    p.LEV_INV0_SPEED_TQ_EST_CTRL = 100.0;  % [rpm] この付近を境に推定式を切替

    % ---------------------------------------------------------------
    % 温度デレーティング閾値
    % （fim_user_inv0.h: TMP_INV0_*）
    % ---------------------------------------------------------------
    % STARTを超えると徐々に制限、FINで制限最大（係数0）になる想定です。
    p.TMP_INV0_IGBT_LIMIT_START = 90.0;   % [°C] IGBT制限開始温度
    p.TMP_INV0_IGBT_LIMIT_FIN   = 100.0;  % [°C] IGBT制限終了温度
    p.TMP_INV0_MOT1_LIMIT_START = 120.0;  % [°C] モータ温度1 制限開始
    p.TMP_INV0_MOT1_LIMIT_FIN   = 130.0;  % [°C] モータ温度1 制限終了
    p.TMP_INV0_MOT2_LIMIT_START = 120.0;  % [°C] モータ温度2 制限開始
    p.TMP_INV0_MOT2_LIMIT_FIN   = 130.0;  % [°C] モータ温度2 制限終了

    % ---------------------------------------------------------------
    % SVPWM関連
    % （fim_user_inv0.h: M_INV0_MAX, K_INV0_MODU_MAX, WCLPF_INV0_M）
    % ---------------------------------------------------------------
    p.M_INV0_MAX      = 1.10;     % 変調率上限
    p.K_INV0_MODU_MAX = 27.259;   % PWM変調ゲイン（組み込み値踏襲）
    p.WCLPF_INV0_M    = 200.0;    % [rad/s] 変調率LPFカットオフ

    % ---------------------------------------------------------------
    % DCバス公称値（シミュレーション用補助値）
    % ---------------------------------------------------------------
    % ※これは fim_user_inv0.h 直接定義ではなく、MATLAB側運用のため追加。
    p.VDC_NOM = 48.0;             % [V] 公称DCバス電圧
end